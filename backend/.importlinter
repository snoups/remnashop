[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:core-layer]
name = core does not depend on modules or processes
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
forbidden_modules =
    app.modules
    app.api
    app.worker
    app.telegram

[importlinter:contract:modules-layer]
name = only routers and tasks reach into their process
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules
forbidden_modules =
    app.api
    app.worker
    app.telegram
ignore_imports =
    app.modules.*.api.** -> app.api.**
    app.modules.*.tasks -> app.worker.**

[importlinter:contract:usecases-without-sqlalchemy]
name = usecases do not touch sqlalchemy
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules.*.usecases
forbidden_modules =
    sqlalchemy

# Module boundaries: everything below a module's package is private, other code
# goes through its __init__.py. app.api.routers and app.worker.subscribers are the
# composition roots that wire each module's routers and subscribers.

[importlinter:contract:advertising-boundary]
name = advertising internals are private
type = protected
protected_modules =
    app.modules.advertising.*
allowed_importers =
    app.modules.advertising
    app.api.routers
    app.worker.subscribers

