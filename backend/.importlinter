[importlinter]
root_package = app
include_external_packages = True
contract_types =
    module_boundaries: import_contracts.ModuleBoundariesContract

[importlinter:contract:core-layer]
name = core does not depend on modules or processes
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
forbidden_modules =
    app.modules
    app.api
    app.worker
    app.telegram

[importlinter:contract:modules-layer]
name = only routers reach into their process
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules
forbidden_modules =
    app.api
    app.worker
    app.telegram
ignore_imports =
    app.modules.*.api.** -> app.api.**

# installed only with the `telegram` extra, so api and worker can't import them
[importlinter:contract:telegram-extra]
name = only the telegram process uses the telegram extra
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
    app.modules
    app.api
    app.worker
    app.cli
forbidden_modules =
    aiogram
    aiogram_dialog
    fluentogram
    segno

[importlinter:contract:usecases-without-sqlalchemy]
name = usecases do not touch sqlalchemy
type = forbidden
allow_indirect_imports = True
source_modules =
    app.modules.*.usecases
forbidden_modules =
    sqlalchemy

# Everything below a module's package is private, other code goes through its
# __init__.py. app.api.routers and app.worker.subscribers are the composition roots
# that wire each module's routers and subscribers.
[importlinter:contract:module-boundaries]
name = module internals are private
type = module_boundaries
container = app.modules
allowed_importers =
    app.api.routers
    app.worker.subscribers
ignore_imports =
    app.telegram.** -> app.modules.dialogs.catalog

[importlinter:contract:modules-acyclic]
name = modules do not depend on each other in a cycle
type = acyclic_siblings
ancestors =
    app.modules
depth = 0
