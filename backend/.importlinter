[importlinter]
root_package = app

[importlinter:contract:auth-encapsulation]
name = auth module internals are private
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
    app.api
    app.telegram
    app.worker
    app.modules.settings
    app.modules.users
    app.modules.gateways
    app.modules.event_log
    app.modules.banners
    app.modules.api_tokens
    app.modules.translations
    app.modules.plans
    app.modules.subscriptions
    app.modules.promocodes
    app.modules.payments
    app.modules.oauth
    app.modules.passkeys
    app.modules.referrals
    app.modules.backups
    app.modules.pricing
    app.modules.blacklist
    app.modules.dialogs
    app.modules.advertising
    app.modules.overview
    app.modules.analytics
forbidden_modules =
    app.modules.auth.repository
    app.modules.auth.dto
    app.modules.auth.di
    app.modules.auth.usecases

