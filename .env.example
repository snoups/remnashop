# Minimal template for configuring Remnashop
# Full list of variables and instructions:
# https://remnashop.dev/docs/getting-started/environment/


# Public domain of the dashboard and API
# FORMAT: domain WITHOUT HTTP/HTTPS and WITHOUT a trailing slash, example: shop.example.com
APP_DOMAIN=change_me

# Encrypts secrets in the database, is mixed into admin password hashes, signs backups
# Generate: openssl rand -base64 32
# !!! Never share it. BACK IT UP and NEVER CHANGE it after the first start
# !!! A lost or changed key breaks admin passwords, stored secrets and existing backups
APP_CRYPT_KEY=change_me


# Signs session tokens (JWT), at least 32 characters
# Generate: openssl rand -base64 48
# !!! Never share it. Do not reuse APP_CRYPT_KEY here
APP_JWT_SECRET=change_me

# Public domain of the web cabinet, leave unset if you don't run it
# FORMAT: domain WITHOUT HTTP/HTTPS and WITHOUT a trailing slash, example: cabinet.example.com
# CABINET_DOMAIN=

# Same value as CABINET_PROXY_SECRET in the web cabinet, required if you run it
# CABINET_PROXY_SECRET=

# Address of the Remnawave panel
# FORMAT: hostname or Docker service name WITHOUT HTTP/HTTPS and WITHOUT a trailing slash
REMNAWAVE_HOST=remnawave

# Created in the Remnawave: Settings -> API Tokens
REMNAWAVE_TOKEN=change_me

# Same value as WEBHOOK_SECRET_HEADER in the Remnawave .env
REMNAWAVE_WEBHOOK_SECRET=change_me

# Database password
# Generate: openssl rand -hex 32
DATABASE_PASSWORD=change_me



# Optional settings with default values, uncomment to change
# APP_METRICS_ENABLED=false
# APP_ORIGINS=""
# APP_SECURE_COOKIES=true

# DATABASE_HOST="remnashop-db"
# DATABASE_PORT=5432
# DATABASE_NAME="remnashop"
# DATABASE_USER="remnashop"
# DATABASE_ECHO=false
# DATABASE_ECHO_POOL=false
# Each of api, telegram and worker opens up to POOL_SIZE + MAX_OVERFLOW
# connections; their sum must fit in the server's max_connections
# (for an external database its owner sets that limit).
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_MAX_CONNECTIONS=200
# Concurrent worker tasks; keep below the worker's pool
# WORKER_MAX_ASYNC_TASKS=25
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# DATABASE_STATEMENT_TIMEOUT_MS=60000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
# DATABASE_COMMAND_TIMEOUT_S=75
# DATABASE_CONNECT_TIMEOUT_S=10

# LOG_TO_FILE=true
# LOG_LEVEL="DEBUG"
# LOG_ROTATION="100MB"
# LOG_COMPRESSION="zip"
# LOG_RETENTION="3 days"

# REDIS_HOST="remnashop-redis"
# REDIS_PORT=6379
# REDIS_NAME="0"
# REDIS_PASSWORD=""

# REMNAWAVE_CADDY_TOKEN=""
# REMNAWAVE_COOKIE=""

# REMNAWAVE_CF_CLIENT_ID=""
# REMNAWAVE_CF_CLIENT_SECRET=""